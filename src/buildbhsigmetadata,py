import os
import re
import pandas as pd

def build_bhsig_metadata(root_dir, script_label):
    records = []
    pattern = re.compile(r'[BH]-S-(\d+)-([GF])-(\d+)\.tif', re.IGNORECASE)

    for dirpath, _, filenames in os.walk(root_dir):
        for fname in filenames:
            m = pattern.match(fname)
            if not m:
                continue
            writer_id, kind, sample_id = m.groups()
            label = "genuine" if kind.upper() == "G" else "forged"
            records.append({
                "writer_id": int(writer_id),
                "sample_id": int(sample_id),
                "label": label,
                "script": script_label,
                "filepath": os.path.join(dirpath, fname),
            })

    df = pd.DataFrame(records)
    assert len(df) > 0, f"No files matched for {script_label} — check pattern against actual filenames."
    return df

